    {
      "parameters": {
        "jsCode": "const form = $(\"New Customer Form\").item.json;\n\nfunction esc(val) {\n  if (val === undefined || val === null || val === \"\") return \"N/A\";\n  return String(val)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\");\n}\n\nconst rows = [\n  [\"Customer Name\", form.customerName],\n  [\"Phone\", form.phone],\n  [\"Email\", form.email],\n  [\"Address\", form.address],\n  [\"Date\", form.date]\n];\n\nlet bodyRows = \"\";\nfor (const pair of rows) {\n  const label = pair[0];\n  const value = pair[1];\n  bodyRows += \"<tr><td style=\\\"padding:8px;border:1px solid #ddd;font-weight:bold;background-color:#f5f5f5;\\\">\" + esc(label) + \"</td><td style=\\\"padding:8px;border:1px solid #ddd;\\\">\" + esc(value) + \"</td></tr>\";\n}\n\nconst htmlTable = \"<table style=\\\"border-collapse:collapse;width:100%;max-width:500px;font-family:Arial,sans-serif;font-size:14px;\\\">\" +\n  \"<thead><tr><th colspan=\\\"2\\\" style=\\\"padding:10px;border:1px solid #ddd;background-color:#4a90d9;color:#ffffff;text-align:left;\\\">New Customer Data</th></tr></thead>\" +\n  \"<tbody>\" + bodyRows + \"</tbody></table>\";\n\nreturn [{ json: { htmlTable: htmlTable } }];"
      },
